<script>
    // typing animation
    const roles = ["Computer Programming Student", "Web Developer", "Accessibility Designer", "Future Full-Stack Dev"];
    let idx = 0, ch = 0, del = false;
    const typedEl = document.getElementById('typedText');
    function typeEffect() {
        const current = roles[idx];
        if(del) ch--;
        else ch++;
        typedEl.textContent = current.substring(0,ch);
        if(!del && ch === current.length) { del = true; setTimeout(typeEffect, 1800); return; }
        if(del && ch === 0) { del = false; idx = (idx+1)%roles.length; setTimeout(typeEffect, 300); return; }
        setTimeout(typeEffect, del ? 60 : 90);
    }
    typeEffect();

    // functional tabs
    const tabBtns = document.querySelectorAll('.tab-btn');
    const panels = {
        works: document.getElementById('works-panel'),
        achievements: document.getElementById('achievements-panel'),
        other: document.getElementById('other-panel')
    };
    tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const tabId = btn.getAttribute('data-tab');
            tabBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            Object.values(panels).forEach(p => p.classList.remove('active'));
            if(tabId === 'works') panels.works.classList.add('active');
            if(tabId === 'achievements') panels.achievements.classList.add('active');
            if(tabId === 'other') panels.other.classList.add('active');
        });
    });

    // testimonial slider
    const track = document.getElementById('testimonialTrack');
    const cards = document.querySelectorAll('.testimonial-card');
    const indicatorsDiv = document.getElementById('testimonialIndicators');
    let currentTestimonial = 0;
    function buildIndicators() { cards.forEach((_,i) => { let dot = document.createElement('span'); dot.classList.add('testimonial-indicator'); if(i===0) dot.classList.add('active'); dot.dataset.index = i; indicatorsDiv.appendChild(dot); }); }
    function updateSlider() { track.style.transform = `translateX(-${currentTestimonial * 100}%)`; document.querySelectorAll('.testimonial-indicator').forEach((dot, i) => { dot.classList.toggle('active', i===currentTestimonial); }); }
    document.getElementById('testimonialPrev')?.addEventListener('click',()=>{ currentTestimonial = (currentTestimonial-1+cards.length)%cards.length; updateSlider(); });
    document.getElementById('testimonialNext')?.addEventListener('click',()=>{ currentTestimonial = (currentTestimonial+1)%cards.length; updateSlider(); });
    buildIndicators(); updateSlider();
    document.querySelectorAll('.testimonial-indicator').forEach(dot => { dot.addEventListener('click', (e)=> { currentTestimonial = parseInt(e.target.dataset.index); updateSlider(); }); });
    setInterval(()=>{ currentTestimonial = (currentTestimonial+1)%cards.length; updateSlider(); }, 6500);

    // navbar scroll + active highlight
    window.addEventListener('scroll', () => {
        const navbar = document.getElementById('navbar');
        if(window.scrollY>50) navbar.classList.add('scrolled'); else navbar.classList.remove('scrolled');
        const sections = document.querySelectorAll('section');
        let currentId = '';
        sections.forEach(sec => { const rect = sec.getBoundingClientRect(); if(rect.top <= 150 && rect.bottom >= 100) currentId = sec.getAttribute('id'); });
        document.querySelectorAll('.nav-links a').forEach(link => { link.classList.remove('active'); if(link.getAttribute('href') === `#${currentId}`) link.classList.add('active'); });
    });

    // mobile menu
    const menuBtn = document.getElementById('menuBtn'), navLinks = document.getElementById('navLinks');
    menuBtn.addEventListener('click',()=> navLinks.classList.toggle('active'));
    document.querySelectorAll('.nav-links a').forEach(link => link.addEventListener('click',()=> navLinks.classList.remove('active')));

    // smooth scroll
    document.querySelectorAll('a[href^="#"]').forEach(anchor => { anchor.addEventListener('click', function(e) { e.preventDefault(); const target = document.querySelector(this.getAttribute('href')); if(target) target.scrollIntoView({ behavior:'smooth' }); }); });

    // contact form
    document.getElementById('contactForm').addEventListener('submit', (e) => { e.preventDefault(); const name = document.getElementById('name').value; if(name && document.getElementById('email').value && document.getElementById('message').value) { alert(`Thanks ${name}, I'll reach out soon!`); e.target.reset(); } else alert('Please fill in all fields.'); });
    document.getElementById('resumeMockBtn')?.addEventListener('click', (e) => { e.preventDefault(); alert('Resume preview — contact me for detailed CV.'); });
</script>
